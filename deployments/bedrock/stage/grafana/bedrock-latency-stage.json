{
  "title": "Bedrock \u2014 Latency \u2014 stage",
  "description": "Latency p50/p95/p99 by Bedrock model (CloudWatch metrics) and by app feature (Logs Insights over Bedrock invocation log + ai.call lines).",
  "tags": [
    "latency",
    "bedrock",
    "stage",
    "ai"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
