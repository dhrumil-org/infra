          "metricName": "InvocationLatency",
          "statistic": "p50",
          "period": "60",
          "dimensions": {
            "ModelId": "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-2-multimodal-embeddings-v1:0"
          },
          "region": "us-east-1",
          "alias": "Nova-2 emb p50",
