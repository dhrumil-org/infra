    {
      "id": 2,
      "type": "row",
      "title": "Per-feature latency (from Bedrock invocation log)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Bedrock Converse \u2014 calls by feature \u00d7 model (last range)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "logGroupNames": [
            "/aws/bedrock/vocuone-invocations"
          ],
          "region": "us-east-1",
          "expression": "filter requestMetadata.env = \"stage\" and ispresent(requestMetadata.feature) | stats count() as calls by requestMetadata.feature, modelId | sort calls desc"
        }
      ]
    },
    {
      "id": 3,
      "type": "row",
      "title": "ai.call latency (KB Retrieve, Comprehend, PhysioAssistant)",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 30,
      "type": "table",
      "title": "ai.call latency by feature \u2014 p50 / p95 / p99",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "logGroupNames": [
            "/ecs/vocuone-stage-app"
          ],
          "region": "us-east-1",
          "expression": "filter @message like /\"marker\":\"ai\\.call\"/ | parse @message /\"feature\":\"(?<feature>[^\"]+)\"/ | parse @message /\"operation\":\"(?<operation>[^\"]+)\"/ | parse @message /\"status\":\"(?<status>[^\"]+)\"/ | parse @message /\"latency_ms\":(?<latency_ms>\\d+)/ | stats count() as calls, avg(latency_ms) as avg_ms, pct(latency_ms, 50) as p50, pct(latency_ms, 95) as p95, pct(latency_ms, 99) as p99 by feature, operation, status | sort calls desc"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "ai.call p95 latency over time, by feature",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "logGroupNames": [
            "/ecs/vocuone-stage-app"
          ],
          "region": "us-east-1",
          "expression": "filter @message like /\"marker\":\"ai\\.call\"/ | parse @message /\"feature\":\"(?<feature>[^\"]+)\"/ | parse @message /\"operation\":\"(?<operation>[^\"]+)\"/ | parse @message /\"status\":\"(?<status>[^\"]+)\"/ | parse @message /\"latency_ms\":(?<latency_ms>\\d+)/ | stats pct(latency_ms, 95) as p95 by bin(5m), feature"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Comprehend Medical latency (CloudWatch metric)",
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 99,
      "type": "text",
      "title": "Note",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Comprehend Medical does not emit CloudWatch metrics** in this AWS account/region (`AWS/ComprehendMedical` namespace is empty). Use the **ai.call latency by feature** table above and filter `feature = comprehend_icd` for per-call latency, status, and chunk size."
      }
    }
  ],
