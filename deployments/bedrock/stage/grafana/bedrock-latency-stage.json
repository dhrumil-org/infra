    {
      "id": 11,
      "type": "timeseries",
      "title": "Nova Pro / Nova-2 embeddings \u2014 latency",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/Bedrock",
          "metricName": "InvocationLatency",
          "statistic": "p50",
          "period": "60",
          "dimensions": {
            "ModelId": "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-pro-v1:0"
          },
          "region": "us-east-1",
          "alias": "Nova Pro p50",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": "",
          "expression": ""
        },
        {
          "refId": "B",
          "namespace": "AWS/Bedrock",
          "metricName": "InvocationLatency",
          "statistic": "p95",
          "period": "60",
          "dimensions": {
            "ModelId": "arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-pro-v1:0"
          },
          "region": "us-east-1",
          "alias": "Nova Pro p95",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "matchExact": true,
          "id": "",
          "expression": ""
        },
        {
